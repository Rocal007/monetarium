# MONETARIUM — Börsen- & API-Konfiguration
# Kopiere diese Datei nach .env.local und trage deine Schlüssel ein:
# cp .env.example .env.local

# -------------------------------------------------------------
# 1. MODUS-SCHALTER (SICHERHEITS-GUARD)
# -------------------------------------------------------------
# Standardmäßig auf TESTNET gesetzt! Nur auf LIVE ändern, wenn
# echtes Geld riskiert werden soll.
TRADING_MODE=TESTNET

# -------------------------------------------------------------
# 2. KRYPTO-BÖRSEN (CCXT)
# -------------------------------------------------------------
# Binance (Spot Testnet: https://testnet.binance.vision/)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=true

# Kraken (Optional)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Bybit (Optional)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# -------------------------------------------------------------
# 3. US-AKTIEN & TRADFI (ALPACA MARKETS)
# -------------------------------------------------------------
# Kostenloses Paper-Trading Konto: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_IS_PAPER=true

# -------------------------------------------------------------
# 4. SERVER & NETWORK
# -------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
