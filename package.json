{
  "name": "monetarium",
  "version": "1.0.0",
  "description": "Monetarium — Quantitative Paper Trading & Algorithmic Terminal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
