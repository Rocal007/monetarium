    "test:quant": "tsx src/lib/analytics/test-quant.ts",
    "test:agents": "tsx src/lib/agents/test-agent-strategies.ts",
    "test:pilot-copilot": "tsx src/lib/agents/test-pilot-copilot.ts",
    "test:sentinel": "tsx src/lib/agents/data-integrity/test-data-sentinel.ts",
    "test:storage": "tsx src/lib/storage/test-sqlite-store.ts",
    "test:crypto": "tsx src/lib/crypto/test-crypto-allocator.ts",
    "test:strategies": "tsx src/lib/strategies/test-all-strategies.ts",
    "backtest:turbo": "tsx src/scripts/backtest-alpha-turbo.ts",
    "daemon": "tsx src/scripts/headless-runner.ts",
    "test:local-ai": ".venv/bin/python src/scripts/verify-local-ai-stack.py"
  },
  "dependencies": {
    "ccxt": "^4.5.77",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
